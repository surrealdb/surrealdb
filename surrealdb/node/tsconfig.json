{
	"compilerOptions": {
		// The only TypeScript left here is the build, publish and test scripts,
		// all of which run under Bun. The published typings are generated by
		// NAPI, not compiled from here.
		"lib": ["ESNext"],
		"target": "ESNext",
		"module": "ESNext",
		"moduleDetection": "force",

		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,

		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitOverride": true
	},
	"exclude": ["node_modules", "dist", "napi"]
}
