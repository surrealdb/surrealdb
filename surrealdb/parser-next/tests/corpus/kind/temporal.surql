date;
time;
timestamp;
interval;
DATE;
option<date>;
array<time>;
array<timestamp, 3>;
set<interval>;
date | time | timestamp | interval;
{ a: date, b: option<interval> };
[date, time];
<date> $x;
<time> $x;
<timestamp> $x;
<interval> $x;
DEFINE FIELD a ON t TYPE date;
DEFINE FIELD a ON t TYPE option<timestamp> | interval;
