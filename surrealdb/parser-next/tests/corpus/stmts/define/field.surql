DEFINE FIELD f ON t;
DEFINE FIELD f ON t TYPE { a: int };
DEFINE FIELD f ON t FLEXIBLE TYPE { a: int };
DEFINE FIELD f ON t READONLY FLEXIBLE;
DEFINE FIELD f ON t VALUE 1 READONLY;
DEFINE FIELD f ON t ASSERT 1 == 1 VALUE 1;
DEFINE FIELD f ON t COMPUTED 2 ASSERT 1 == 1;
DEFINE FIELD f ON t DEFAULT 3 COMPUTED 2;
DEFINE FIELD f ON t PERMISSIONS FULL DEFAULT 3;
DEFINE FIELD f ON t COMMENT "comment" PERMISSIONS FULL;
DEFINE FIELD f ON t REFERENCE ON DELETE IGNORE COMMENT "comment";
DEFINE FIELD f ON t REFERENCE ON DELETE REJECT;
DEFINE FIELD f ON t REFERENCE ON DELETE CASCADE;
DEFINE FIELD f ON t REFERENCE ON DELETE UNSET;
DEFINE FIELD f ON t REFERENCE ON DELETE THEN 1 - 2;
DEFINE FIELD score ON likes TYPE number INLINE;
DEFINE FIELD author ON post TYPE record<author> REFERENCE MATERIALIZE INTO author.posts;
DEFINE FIELD author ON post TYPE record<author> REFERENCE ON DELETE CASCADE MATERIALIZE INTO author.posts;
DEFINE FIELD author ON post TYPE record<author> REFERENCE ON DELETE THEN 1 - 2 MATERIALIZE INTO author.posts WHERE archived != true COMMENT "c";
DEFINE FIELD OVERWRITE author ON post TYPE record<author> REFERENCE ON DELETE UNSET MATERIALIZE INTO `author`.`posts` WHERE a AND b;
DEFINE FIELD author ON post TYPE record<author> MATERIALIZE INTO author.posts REFERENCE;
DEFINE FIELD materialize ON materialize TYPE int;
DEFINE FIELD materialize ON t REFERENCE MATERIALIZE INTO materialize.materialize;
