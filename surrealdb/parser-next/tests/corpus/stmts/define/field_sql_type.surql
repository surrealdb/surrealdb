DEFINE FIELD n ON t TYPE decimal SQL TYPE POSTGRESQL 'numeric(10,2)';
DEFINE FIELD n ON t TYPE decimal sql type postgresql 'numeric(10,2)';
DEFINE FIELD OVERWRITE n ON t SQL TYPE MYSQL 'DECIMAL(10,2)' TYPE decimal READONLY COMMENT "c";
DEFINE FIELD IF NOT EXISTS n ON t TYPE string DEFAULT 'a' SQL TYPE DYNAMODB 'S' VALUE $value ASSERT $value != '';
DEFINE FIELD n ON t TYPE object FLEXIBLE SQL TYPE POSTGRESQL 'jsonb' PERMISSIONS FULL;
DEFINE FIELD n ON t SQL TYPE POSTGRESQL 'inet' MIGRATE EXISTING ROWS AS fill USING $value;
DEFINE FIELD n ON t TYPE string SQL TYPE POSTGRESQL 'varchar(20)' REFERENCE CASCADE GRAPHQL_ALIAS "name";
DEFINE FIELD n ON t TYPE string SQL TYPE POSTGRESQL 'it''s';
DEFINE FIELD n ON t TYPE string SQL TYPE POSTGRESQL "double";
DEFINE FIELD n ON t TYPE int SQL TYPE ORACLE 'number';
DEFINE FIELD n ON t TYPE int SQL TYPE POSTGRESQL;
DEFINE FIELD n ON t TYPE int SQL POSTGRESQL 'int4';
DEFINE FIELD n ON t TYPE int SQL TYPE 'int4';
DEFINE FIELD sql ON t TYPE int;
ALTER FIELD n ON t SQL TYPE POSTGRESQL 'numeric(12,4)';
ALTER FIELD n ON t DROP SQL TYPE;
ALTER FIELD IF EXISTS n ON t TYPE int SQL TYPE MYSQL 'BIGINT UNSIGNED' DROP COMMENT;
ALTER FIELD n ON t DROP SQL;
ALTER FIELD n ON t SQL TYPE DYNAMODB 'N' DROP SQL TYPE;
ALTER TABLE t SQL TYPE POSTGRESQL 'int';
