BEGIN;
COMMIT;
BEGIN TRANSACTION;
CANCEL TRANSACTION;
BEGIN READ ONLY;
COMMIT;
BEGIN TRANSACTION READ ONLY;
COMMIT;
BEGIN READ ONLY MAX STALENESS 5s;
COMMIT;
BEGIN READ ONLY MAX STALENESS 1h30m STRICT;
COMMIT;
BEGIN TRANSACTION read only max staleness 250ms strict;
CANCEL;
BEGIN READ ONLY MAX STALENESS $s;
COMMIT;
BEGIN READ ONLY MAX STALENESS $s STRICT;
COMMIT;
-- `read`, `max` and `staleness` are not reserved.
SELECT read, max, staleness FROM read;
