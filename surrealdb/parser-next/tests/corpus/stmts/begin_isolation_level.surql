BEGIN ISOLATION LEVEL SNAPSHOT;
COMMIT;
BEGIN TRANSACTION ISOLATION LEVEL SERIALIZABLE;
COMMIT;
BEGIN isolation level serializable read only;
CANCEL;
BEGIN READ ONLY ISOLATION LEVEL SNAPSHOT;
COMMIT;
BEGIN ISOLATION LEVEL SERIALIZABLE READ ONLY MAX STALENESS 0s STRICT;
COMMIT;
BEGIN READ ONLY MAX STALENESS $s STRICT ISOLATION LEVEL SNAPSHOT;
COMMIT;
-- `isolation`, `level`, `snapshot` and `serializable` are not reserved.
SELECT isolation, level, snapshot, serializable FROM isolation;
