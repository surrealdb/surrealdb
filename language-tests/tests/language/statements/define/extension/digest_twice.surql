/**
[env]
namespace = true
database = true
auth = { level = "owner" }

[env.capabilities]
allow-experimental = ["surrealism", "files"]

[test]
reason = """DIGEST pins one archive, so a second DIGEST is refused rather than silently replacing the first."""

[test.results]
parsing-error = """
Conflicting clause on this extension definition
  --> [28:148]
   |
28 | ... UNSIGNED DIGEST "sha256:5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5...
   |              ^^^^^^ An extension definition takes one `DIGEST`
  --> [28:58]
   |
28 | ...or.surli" DIGEST "sha256:5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5...
   |              ^^^^^^ First given here
"""

*/

DEFINE EXTENSION ext::color FROM f"modules:/color.surli" DIGEST "sha256:5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d" UNSIGNED DIGEST "sha256:5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d";
