DEFINE TABLE x SCHEMAFULL;
DEFINE FIELD i ON x TYPE int;
DEFINE FIELD f ON x TYPE float;
DEFINE FIELD dec ON x TYPE decimal;
DEFINE FIELD s ON x TYPE string;
DEFINE FIELD o ON x TYPE option<int>;
DEFINE FIELD nl ON x TYPE int | null;
DEFINE FIELD c ON x TYPE int COMPUTED i + 1;
FOR $n IN 0..60 {
	CREATE type::record('x', $n) CONTENT {
		i: $n % 40,
		f: <float> ($n % 23) / 4,
		dec: <decimal> ($n % 31),
		s: 's' + <string> ($n % 17),
		o: IF $n % 4 = 0 { NONE } ELSE { $n % 13 },
		nl: IF $n % 5 = 0 { NULL } ELSE { $n % 11 }
	} RETURN NONE;
};
SELECT VALUE id FROM x WHERE i IN [1, 5, 9];
SELECT VALUE id FROM x WHERE i NOT IN [1, 5, 9];
SELECT VALUE id FROM x WHERE NOT (i IN [1, 5, 9]);
SELECT VALUE id FROM x WHERE i IN [1, 5.0, 9];
SELECT VALUE id FROM x WHERE i IN [1.5, 5];
SELECT VALUE id FROM x WHERE i IN [1, 5dec, 9];
SELECT VALUE id FROM x WHERE i IN [1, 5, 'a'];
SELECT VALUE id FROM x WHERE i IN [];
SELECT VALUE id FROM x WHERE i IN [1, 5, 9] OR i IN [20, 21];
SELECT VALUE id FROM x WHERE i = 1 OR i = 5 OR i = 9;
SELECT VALUE id FROM x WHERE i != 1 AND i != 5;
SELECT VALUE id FROM x WHERE i > 30 AND i != 35;
SELECT VALUE id FROM x WHERE i != 7;
SELECT VALUE id FROM x WHERE f IN [0, 2];
SELECT VALUE id FROM x WHERE f IN [0, 0.25, 1.5];
SELECT VALUE id FROM x WHERE f NOT IN [0, 2];
SELECT VALUE id FROM x WHERE dec IN [3, 4];
SELECT VALUE id FROM x WHERE dec IN [3dec, 4];
SELECT VALUE id FROM x WHERE dec IN [3.0, 4.5];
SELECT VALUE id FROM x WHERE s IN [1, 's3', 's5'];
SELECT VALUE id FROM x WHERE s NOT IN ['s3', 's5'];
SELECT VALUE id FROM x WHERE o IN [1, 5];
SELECT VALUE id FROM x WHERE o NOT IN [1, 5];
SELECT VALUE id FROM x WHERE o IN [1, 5.0];
SELECT VALUE id FROM x WHERE nl IN [1, 5];
SELECT VALUE id FROM x WHERE nl NOT IN [1, 5];
SELECT VALUE id FROM x WHERE nl IN [NULL, 5];
SELECT VALUE id FROM x WHERE absent IN [1, 5];
SELECT VALUE id FROM x WHERE absent NOT IN [1, 5];
