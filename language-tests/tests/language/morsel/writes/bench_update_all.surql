DEFINE TABLE record SCHEMALESS;
FOR $i IN 1..201 { CREATE type::record('record', $i) SET n = $i, name = 'n' + <string> $i RETURN NONE; };
UPDATE record SET name = name + ' hi!';
SELECT count() FROM record WHERE string::ends_with(name, ' hi!') GROUP ALL;
