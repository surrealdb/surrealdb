	{ q: 'u page a > 1 AND a <= 3 ASC (plan)', ok: (EXPLAIN SELECT VALUE id FROM u WITH INDEX ix WHERE a > 1 AND a <= 3 ORDER BY a ASC, b ASC, id LIMIT 1 START 1).contains('Index') },
	{ q: 'u a > 1 AND a <= 3 DESC', ok: (SELECT VALUE id FROM u WITH INDEX ix WHERE a > 1 AND a <= 3 ORDER BY a DESC, b DESC, id) == (SELECT VALUE id FROM u WITH NOINDEX WHERE a > 1 AND a <= 3 ORDER BY a DESC, b DESC, id) },
	{ q: 'u a > 1 AND a <= 3 DESC (plan)', ok: (EXPLAIN SELECT VALUE id FROM u WITH INDEX ix WHERE a > 1 AND a <= 3 ORDER BY a DESC, b DESC, id).contains('Index') },
