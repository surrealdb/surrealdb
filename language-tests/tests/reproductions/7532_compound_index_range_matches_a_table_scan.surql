/**
[env]
namespace = true
database = true
auth = { level = "owner" }
timeout = 10000

[test]
reason = "Every range on a compound index, plain and UNIQUE, on its leading and on a trailing column, over two columns (u) and three (w), read ascending and descending, paged, counted and updated, selects the rows a table scan of the same predicate selects. Each oracle check also requires its plan to read the index, and each oracle statement lists the checks that do not hold."
issue = 7532

[[test.results]]
value = "NONE"

[[test.results]]
value = "NONE"

[[test.results]]
value = "[]"

[[test.results]]
value = "[]"

[[test.results]]
value = "[]"

[[test.results]]
value = "[]"

[[test.results]]
value = "NONE"

[[test.results]]
value = "NONE"

[[test.results]]
value = "[]"

[[test.results]]
value = "[]"

[[test.results]]
value = "NONE"

[[test.results]]
value = "NONE"

[[test.results]]
value = "NONE"

[[test.results]]
value = "NONE"

[[test.results]]
value = "[]"

[[test.results]]
value = "[]"

[[test.results]]
value = "[]"

[[test.results]]
value = "[]"

[[test.results]]
value = "NONE"

[[test.results]]
value = "NONE"

[[test.results]]
value = "NONE"

[[test.results]]
value = "NONE"

[[test.results]]
value = "[]"

[[test.results]]
value = "[]"

[[test.results]]
value = "[]"

[[test.results]]
value = "[]"
*/

-- Two columns: one row per (a, b), as a UNIQUE index requires, with values of
-- other types beside the integers.
DEFINE TABLE u SCHEMALESS;
FOR $a IN 1..=5 {
	CREATE type::record('u', $a) SET a = $a, b = false RETURN NONE;
	CREATE type::record('u', $a + 10) SET a = $a, b = true RETURN NONE;
};
CREATE u:20 SET b = false RETURN NONE;
CREATE u:21 SET a = 'x', b = false RETURN NONE;
CREATE u:22 SET a = 3, b = NULL RETURN NONE;
CREATE u:23 SET a = 3, b = 'z' RETURN NONE;

-- Three columns: several rows per (a, b), so a bound on c excludes rows.
DEFINE TABLE w SCHEMALESS;
FOR $a IN 1..=5 { FOR $b IN [false, true] { FOR $c IN 0..3 {
	CREATE w SET a = $a, b = $b, c = $c RETURN NONE;
}; }; };
CREATE w SET a = 'x', b = false, c = 0 RETURN NONE;

-- Every predicate matches at least two rows, so each paged read drops a row
-- and keeps another.

RETURN [
	{ q: 'u b = false AND a > 3', n: array::len(SELECT VALUE id FROM u WITH NOINDEX WHERE b = false AND a > 3) },
	{ q: 'u b = false AND a >= 3', n: array::len(SELECT VALUE id FROM u WITH NOINDEX WHERE b = false AND a >= 3) },
	{ q: 'u b = false AND a < 3', n: array::len(SELECT VALUE id FROM u WITH NOINDEX WHERE b = false AND a < 3) },
	{ q: 'u b = false AND a <= 3', n: array::len(SELECT VALUE id FROM u WITH NOINDEX WHERE b = false AND a <= 3) },
	{ q: 'u a > 3', n: array::len(SELECT VALUE id FROM u WITH NOINDEX WHERE a > 3) },
	{ q: 'u a >= 3', n: array::len(SELECT VALUE id FROM u WITH NOINDEX WHERE a >= 3) },
	{ q: 'u a < 3', n: array::len(SELECT VALUE id FROM u WITH NOINDEX WHERE a < 3) },
	{ q: 'u a <= 3', n: array::len(SELECT VALUE id FROM u WITH NOINDEX WHERE a <= 3) },
	{ q: 'u a > 1 AND a <= 3', n: array::len(SELECT VALUE id FROM u WITH NOINDEX WHERE a > 1 AND a <= 3) },
	{ q: 'u a >= 2 AND a < 4', n: array::len(SELECT VALUE id FROM u WITH NOINDEX WHERE a >= 2 AND a < 4) },
	{ q: 'u b = false AND a > 1 AND a <= 3', n: array::len(SELECT VALUE id FROM u WITH NOINDEX WHERE b = false AND a > 1 AND a <= 3) },
	{ q: 'u a = 3 AND b > false', n: array::len(SELECT VALUE id FROM u WITH NOINDEX WHERE a = 3 AND b > false) },
	{ q: 'u a = 3 AND b <= true', n: array::len(SELECT VALUE id FROM u WITH NOINDEX WHERE a = 3 AND b <= true) },
	{ q: "u a = 3 AND b >= false AND b < 'z'", n: array::len(SELECT VALUE id FROM u WITH NOINDEX WHERE a = 3 AND b >= false AND b < 'z') },
	{ q: 'w b = false AND a > 3', n: array::len(SELECT VALUE id FROM w WITH NOINDEX WHERE b = false AND a > 3) },
	{ q: 'w b = false AND a >= 3', n: array::len(SELECT VALUE id FROM w WITH NOINDEX WHERE b = false AND a >= 3) },
	{ q: 'w b = false AND a < 3', n: array::len(SELECT VALUE id FROM w WITH NOINDEX WHERE b = false AND a < 3) },
	{ q: 'w b = false AND a <= 3', n: array::len(SELECT VALUE id FROM w WITH NOINDEX WHERE b = false AND a <= 3) },
	{ q: 'w a > 3', n: array::len(SELECT VALUE id FROM w WITH NOINDEX WHERE a > 3) },
	{ q: 'w a >= 3', n: array::len(SELECT VALUE id FROM w WITH NOINDEX WHERE a >= 3) },
	{ q: 'w a < 3', n: array::len(SELECT VALUE id FROM w WITH NOINDEX WHERE a < 3) },
	{ q: 'w a <= 3', n: array::len(SELECT VALUE id FROM w WITH NOINDEX WHERE a <= 3) },
	{ q: 'w a > 1 AND a <= 3', n: array::len(SELECT VALUE id FROM w WITH NOINDEX WHERE a > 1 AND a <= 3) },
	{ q: 'w a >= 2 AND a < 4', n: array::len(SELECT VALUE id FROM w WITH NOINDEX WHERE a >= 2 AND a < 4) },
	{ q: 'w b = false AND a > 1 AND a <= 3', n: array::len(SELECT VALUE id FROM w WITH NOINDEX WHERE b = false AND a > 1 AND a <= 3) },
	{ q: 'w a = 3 AND b > false', n: array::len(SELECT VALUE id FROM w WITH NOINDEX WHERE a = 3 AND b > false) },
	{ q: 'w a = 3 AND b <= true', n: array::len(SELECT VALUE id FROM w WITH NOINDEX WHERE a = 3 AND b <= true) },
	{ q: 'w a = 3 AND b = false AND c > 0', n: array::len(SELECT VALUE id FROM w WITH NOINDEX WHERE a = 3 AND b = false AND c > 0) },
	{ q: 'w a = 3 AND b = false AND c <= 1', n: array::len(SELECT VALUE id FROM w WITH NOINDEX WHERE a = 3 AND b = false AND c <= 1) },
	{ q: 'w a = 3 AND b = false AND c >= 1 AND c <= 2', n: array::len(SELECT VALUE id FROM w WITH NOINDEX WHERE a = 3 AND b = false AND c >= 1 AND c <= 2) },
	{ q: 'w a = 3 AND b = true AND c < 2', n: array::len(SELECT VALUE id FROM w WITH NOINDEX WHERE a = 3 AND b = true AND c < 2) }
].filter(|$c| $c.n < 2).map(|$c| $c.q);

-- Reads and writes are checked in separate statements: a statement that writes
-- plans its reads for writing, and a write reads a lower-only range on the
-- leading column (`a > 3`) by a table scan, so the update checks take the
-- predicates it reads through the index.
REMOVE INDEX IF EXISTS ix ON u; REMOVE INDEX IF EXISTS ix ON w;
DEFINE INDEX ix ON u FIELDS a, b; DEFINE INDEX ix ON w FIELDS a, b, c;
RETURN [
	{ q: 'u b = false AND a > 3 ASC', ok: (SELECT VALUE id FROM u WITH INDEX ix WHERE b = false AND a > 3 ORDER BY a ASC, b ASC, id) == (SELECT VALUE id FROM u WITH NOINDEX WHERE b = false AND a > 3 ORDER BY a ASC, b ASC, id) },
	{ q: 'u b = false AND a > 3 ASC (plan)', ok: (EXPLAIN SELECT VALUE id FROM u WITH INDEX ix WHERE b = false AND a > 3 ORDER BY a ASC, b ASC, id).contains('Index') },
	{ q: 'u page b = false AND a > 3 ASC', ok: (SELECT VALUE id FROM u WITH INDEX ix WHERE b = false AND a > 3 ORDER BY a ASC, b ASC, id LIMIT 1 START 1) == (SELECT VALUE id FROM u WITH NOINDEX WHERE b = false AND a > 3 ORDER BY a ASC, b ASC, id LIMIT 1 START 1) },
	{ q: 'u page b = false AND a > 3 ASC (plan)', ok: (EXPLAIN SELECT VALUE id FROM u WITH INDEX ix WHERE b = false AND a > 3 ORDER BY a ASC, b ASC, id LIMIT 1 START 1).contains('Index') },
	{ q: 'u b = false AND a > 3 DESC', ok: (SELECT VALUE id FROM u WITH INDEX ix WHERE b = false AND a > 3 ORDER BY a DESC, b DESC, id) == (SELECT VALUE id FROM u WITH NOINDEX WHERE b = false AND a > 3 ORDER BY a DESC, b DESC, id) },
	{ q: 'u b = false AND a > 3 DESC (plan)', ok: (EXPLAIN SELECT VALUE id FROM u WITH INDEX ix WHERE b = false AND a > 3 ORDER BY a DESC, b DESC, id).contains('Index') },
	{ q: 'u page b = false AND a > 3 DESC', ok: (SELECT VALUE id FROM u WITH INDEX ix WHERE b = false AND a > 3 ORDER BY a DESC, b DESC, id LIMIT 1 START 1) == (SELECT VALUE id FROM u WITH NOINDEX WHERE b = false AND a > 3 ORDER BY a DESC, b DESC, id LIMIT 1 START 1) },
	{ q: 'u page b = false AND a > 3 DESC (plan)', ok: (EXPLAIN SELECT VALUE id FROM u WITH INDEX ix WHERE b = false AND a > 3 ORDER BY a DESC, b DESC, id LIMIT 1 START 1).contains('Index') },
	{ q: 'u count b = false AND a > 3', ok: (SELECT VALUE count() FROM u WITH INDEX ix WHERE b = false AND a > 3 GROUP ALL) == (SELECT VALUE count() FROM u WITH NOINDEX WHERE b = false AND a > 3 GROUP ALL) },
	{ q: 'u count b = false AND a > 3 (plan)', ok: (EXPLAIN SELECT VALUE count() FROM u WITH INDEX ix WHERE b = false AND a > 3 GROUP ALL).contains('Index') },
	{ q: 'u b = false AND a >= 3 ASC', ok: (SELECT VALUE id FROM u WITH INDEX ix WHERE b = false AND a >= 3 ORDER BY a ASC, b ASC, id) == (SELECT VALUE id FROM u WITH NOINDEX WHERE b = false AND a >= 3 ORDER BY a ASC, b ASC, id) },
	{ q: 'u b = false AND a >= 3 ASC (plan)', ok: (EXPLAIN SELECT VALUE id FROM u WITH INDEX ix WHERE b = false AND a >= 3 ORDER BY a ASC, b ASC, id).contains('Index') },
	{ q: 'u page b = false AND a >= 3 ASC', ok: (SELECT VALUE id FROM u WITH INDEX ix WHERE b = false AND a >= 3 ORDER BY a ASC, b ASC, id LIMIT 1 START 1) == (SELECT VALUE id FROM u WITH NOINDEX WHERE b = false AND a >= 3 ORDER BY a ASC, b ASC, id LIMIT 1 START 1) },
	{ q: 'u page b = false AND a >= 3 ASC (plan)', ok: (EXPLAIN SELECT VALUE id FROM u WITH INDEX ix WHERE b = false AND a >= 3 ORDER BY a ASC, b ASC, id LIMIT 1 START 1).contains('Index') },
	{ q: 'u b = false AND a >= 3 DESC', ok: (SELECT VALUE id FROM u WITH INDEX ix WHERE b = false AND a >= 3 ORDER BY a DESC, b DESC, id) == (SELECT VALUE id FROM u WITH NOINDEX WHERE b = false AND a >= 3 ORDER BY a DESC, b DESC, id) },
	{ q: 'u b = false AND a >= 3 DESC (plan)', ok: (EXPLAIN SELECT VALUE id FROM u WITH INDEX ix WHERE b = false AND a >= 3 ORDER BY a DESC, b DESC, id).contains('Index') },
	{ q: 'u page b = false AND a >= 3 DESC', ok: (SELECT VALUE id FROM u WITH INDEX ix WHERE b = false AND a >= 3 ORDER BY a DESC, b DESC, id LIMIT 1 START 1) == (SELECT VALUE id FROM u WITH NOINDEX WHERE b = false AND a >= 3 ORDER BY a DESC, b DESC, id LIMIT 1 START 1) },
	{ q: 'u page b = false AND a >= 3 DESC (plan)', ok: (EXPLAIN SELECT VALUE id FROM u WITH INDEX ix WHERE b = false AND a >= 3 ORDER BY a DESC, b DESC, id LIMIT 1 START 1).contains('Index') },
	{ q: 'u count b = false AND a >= 3', ok: (SELECT VALUE count() FROM u WITH INDEX ix WHERE b = false AND a >= 3 GROUP ALL) == (SELECT VALUE count() FROM u WITH NOINDEX WHERE b = false AND a >= 3 GROUP ALL) },
	{ q: 'u count b = false AND a >= 3 (plan)', ok: (EXPLAIN SELECT VALUE count() FROM u WITH INDEX ix WHERE b = false AND a >= 3 GROUP ALL).contains('Index') },
	{ q: 'u b = false AND a < 3 ASC', ok: (SELECT VALUE id FROM u WITH INDEX ix WHERE b = false AND a < 3 ORDER BY a ASC, b ASC, id) == (SELECT VALUE id FROM u WITH NOINDEX WHERE b = false AND a < 3 ORDER BY a ASC, b ASC, id) },
	{ q: 'u b = false AND a < 3 ASC (plan)', ok: (EXPLAIN SELECT VALUE id FROM u WITH INDEX ix WHERE b = false AND a < 3 ORDER BY a ASC, b ASC, id).contains('Index') },
	{ q: 'u page b = false AND a < 3 ASC', ok: (SELECT VALUE id FROM u WITH INDEX ix WHERE b = false AND a < 3 ORDER BY a ASC, b ASC, id LIMIT 1 START 1) == (SELECT VALUE id FROM u WITH NOINDEX WHERE b = false AND a < 3 ORDER BY a ASC, b ASC, id LIMIT 1 START 1) },
	{ q: 'u page b = false AND a < 3 ASC (plan)', ok: (EXPLAIN SELECT VALUE id FROM u WITH INDEX ix WHERE b = false AND a < 3 ORDER BY a ASC, b ASC, id LIMIT 1 START 1).contains('Index') },
	{ q: 'u b = false AND a < 3 DESC', ok: (SELECT VALUE id FROM u WITH INDEX ix WHERE b = false AND a < 3 ORDER BY a DESC, b DESC, id) == (SELECT VALUE id FROM u WITH NOINDEX WHERE b = false AND a < 3 ORDER BY a DESC, b DESC, id) },
	{ q: 'u b = false AND a < 3 DESC (plan)', ok: (EXPLAIN SELECT VALUE id FROM u WITH INDEX ix WHERE b = false AND a < 3 ORDER BY a DESC, b DESC, id).contains('Index') },
	{ q: 'u page b = false AND a < 3 DESC', ok: (SELECT VALUE id FROM u WITH INDEX ix WHERE b = false AND a < 3 ORDER BY a DESC, b DESC, id LIMIT 1 START 1) == (SELECT VALUE id FROM u WITH NOINDEX WHERE b = false AND a < 3 ORDER BY a DESC, b DESC, id LIMIT 1 START 1) },
	{ q: 'u page b = false AND a < 3 DESC (plan)', ok: (EXPLAIN SELECT VALUE id FROM u WITH INDEX ix WHERE b = false AND a < 3 ORDER BY a DESC, b DESC, id LIMIT 1 START 1).contains('Index') },
	{ q: 'u count b = false AND a < 3', ok: (SELECT VALUE count() FROM u WITH INDEX ix WHERE b = false AND a < 3 GROUP ALL) == (SELECT VALUE count() FROM u WITH NOINDEX WHERE b = false AND a < 3 GROUP ALL) },
	{ q: 'u count b = false AND a < 3 (plan)', ok: (EXPLAIN SELECT VALUE count() FROM u WITH INDEX ix WHERE b = false AND a < 3 GROUP ALL).contains('Index') },
	{ q: 'u b = false AND a <= 3 ASC', ok: (SELECT VALUE id FROM u WITH INDEX ix WHERE b = false AND a <= 3 ORDER BY a ASC, b ASC, id) == (SELECT VALUE id FROM u WITH NOINDEX WHERE b = false AND a <= 3 ORDER BY a ASC, b ASC, id) },
	{ q: 'u b = false AND a <= 3 ASC (plan)', ok: (EXPLAIN SELECT VALUE id FROM u WITH INDEX ix WHERE b = false AND a <= 3 ORDER BY a ASC, b ASC, id).contains('Index') },
	{ q: 'u page b = false AND a <= 3 ASC', ok: (SELECT VALUE id FROM u WITH INDEX ix WHERE b = false AND a <= 3 ORDER BY a ASC, b ASC, id LIMIT 1 START 1) == (SELECT VALUE id FROM u WITH NOINDEX WHERE b = false AND a <= 3 ORDER BY a ASC, b ASC, id LIMIT 1 START 1) },
	{ q: 'u page b = false AND a <= 3 ASC (plan)', ok: (EXPLAIN SELECT VALUE id FROM u WITH INDEX ix WHERE b = false AND a <= 3 ORDER BY a ASC, b ASC, id LIMIT 1 START 1).contains('Index') },
	{ q: 'u b = false AND a <= 3 DESC', ok: (SELECT VALUE id FROM u WITH INDEX ix WHERE b = false AND a <= 3 ORDER BY a DESC, b DESC, id) == (SELECT VALUE id FROM u WITH NOINDEX WHERE b = false AND a <= 3 ORDER BY a DESC, b DESC, id) },
	{ q: 'u b = false AND a <= 3 DESC (plan)', ok: (EXPLAIN SELECT VALUE id FROM u WITH INDEX ix WHERE b = false AND a <= 3 ORDER BY a DESC, b DESC, id).contains('Index') },
	{ q: 'u page b = false AND a <= 3 DESC', ok: (SELECT VALUE id FROM u WITH INDEX ix WHERE b = false AND a <= 3 ORDER BY a DESC, b DESC, id LIMIT 1 START 1) == (SELECT VALUE id FROM u WITH NOINDEX WHERE b = false AND a <= 3 ORDER BY a DESC, b DESC, id LIMIT 1 START 1) },
	{ q: 'u page b = false AND a <= 3 DESC (plan)', ok: (EXPLAIN SELECT VALUE id FROM u WITH INDEX ix WHERE b = false AND a <= 3 ORDER BY a DESC, b DESC, id LIMIT 1 START 1).contains('Index') },
	{ q: 'u count b = false AND a <= 3', ok: (SELECT VALUE count() FROM u WITH INDEX ix WHERE b = false AND a <= 3 GROUP ALL) == (SELECT VALUE count() FROM u WITH NOINDEX WHERE b = false AND a <= 3 GROUP ALL) },
	{ q: 'u count b = false AND a <= 3 (plan)', ok: (EXPLAIN SELECT VALUE count() FROM u WITH INDEX ix WHERE b = false AND a <= 3 GROUP ALL).contains('Index') },
	{ q: 'u a > 3 ASC', ok: (SELECT VALUE id FROM u WITH INDEX ix WHERE a > 3 ORDER BY a ASC, b ASC, id) == (SELECT VALUE id FROM u WITH NOINDEX WHERE a > 3 ORDER BY a ASC, b ASC, id) },
	{ q: 'u a > 3 ASC (plan)', ok: (EXPLAIN SELECT VALUE id FROM u WITH INDEX ix WHERE a > 3 ORDER BY a ASC, b ASC, id).contains('Index') },
	{ q: 'u page a > 3 ASC', ok: (SELECT VALUE id FROM u WITH INDEX ix WHERE a > 3 ORDER BY a ASC, b ASC, id LIMIT 1 START 1) == (SELECT VALUE id FROM u WITH NOINDEX WHERE a > 3 ORDER BY a ASC, b ASC, id LIMIT 1 START 1) },
	{ q: 'u page a > 3 ASC (plan)', ok: (EXPLAIN SELECT VALUE id FROM u WITH INDEX ix WHERE a > 3 ORDER BY a ASC, b ASC, id LIMIT 1 START 1).contains('Index') },
	{ q: 'u a > 3 DESC', ok: (SELECT VALUE id FROM u WITH INDEX ix WHERE a > 3 ORDER BY a DESC, b DESC, id) == (SELECT VALUE id FROM u WITH NOINDEX WHERE a > 3 ORDER BY a DESC, b DESC, id) },
	{ q: 'u a > 3 DESC (plan)', ok: (EXPLAIN SELECT VALUE id FROM u WITH INDEX ix WHERE a > 3 ORDER BY a DESC, b DESC, id).contains('Index') },
	{ q: 'u page a > 3 DESC', ok: (SELECT VALUE id FROM u WITH INDEX ix WHERE a > 3 ORDER BY a DESC, b DESC, id LIMIT 1 START 1) == (SELECT VALUE id FROM u WITH NOINDEX WHERE a > 3 ORDER BY a DESC, b DESC, id LIMIT 1 START 1) },
	{ q: 'u page a > 3 DESC (plan)', ok: (EXPLAIN SELECT VALUE id FROM u WITH INDEX ix WHERE a > 3 ORDER BY a DESC, b DESC, id LIMIT 1 START 1).contains('Index') },
	{ q: 'u count a > 3', ok: (SELECT VALUE count() FROM u WITH INDEX ix WHERE a > 3 GROUP ALL) == (SELECT VALUE count() FROM u WITH NOINDEX WHERE a > 3 GROUP ALL) },
	{ q: 'u count a > 3 (plan)', ok: (EXPLAIN SELECT VALUE count() FROM u WITH INDEX ix WHERE a > 3 GROUP ALL).contains('Index') },
	{ q: 'u a >= 3 ASC', ok: (SELECT VALUE id FROM u WITH INDEX ix WHERE a >= 3 ORDER BY a ASC, b ASC, id) == (SELECT VALUE id FROM u WITH NOINDEX WHERE a >= 3 ORDER BY a ASC, b ASC, id) },
	{ q: 'u a >= 3 ASC (plan)', ok: (EXPLAIN SELECT VALUE id FROM u WITH INDEX ix WHERE a >= 3 ORDER BY a ASC, b ASC, id).contains('Index') },
	{ q: 'u page a >= 3 ASC', ok: (SELECT VALUE id FROM u WITH INDEX ix WHERE a >= 3 ORDER BY a ASC, b ASC, id LIMIT 1 START 1) == (SELECT VALUE id FROM u WITH NOINDEX WHERE a >= 3 ORDER BY a ASC, b ASC, id LIMIT 1 START 1) },
	{ q: 'u page a >= 3 ASC (plan)', ok: (EXPLAIN SELECT VALUE id FROM u WITH INDEX ix WHERE a >= 3 ORDER BY a ASC, b ASC, id LIMIT 1 START 1).contains('Index') },
	{ q: 'u a >= 3 DESC', ok: (SELECT VALUE id FROM u WITH INDEX ix WHERE a >= 3 ORDER BY a DESC, b DESC, id) == (SELECT VALUE id FROM u WITH NOINDEX WHERE a >= 3 ORDER BY a DESC, b DESC, id) },
	{ q: 'u a >= 3 DESC (plan)', ok: (EXPLAIN SELECT VALUE id FROM u WITH INDEX ix WHERE a >= 3 ORDER BY a DESC, b DESC, id).contains('Index') },
	{ q: 'u page a >= 3 DESC', ok: (SELECT VALUE id FROM u WITH INDEX ix WHERE a >= 3 ORDER BY a DESC, b DESC, id LIMIT 1 START 1) == (SELECT VALUE id FROM u WITH NOINDEX WHERE a >= 3 ORDER BY a DESC, b DESC, id LIMIT 1 START 1) },
	{ q: 'u page a >= 3 DESC (plan)', ok: (EXPLAIN SELECT VALUE id FROM u WITH INDEX ix WHERE a >= 3 ORDER BY a DESC, b DESC, id LIMIT 1 START 1).contains('Index') },
	{ q: 'u count a >= 3', ok: (SELECT VALUE count() FROM u WITH INDEX ix WHERE a >= 3 GROUP ALL) == (SELECT VALUE count() FROM u WITH NOINDEX WHERE a >= 3 GROUP ALL) },
	{ q: 'u count a >= 3 (plan)', ok: (EXPLAIN SELECT VALUE count() FROM u WITH INDEX ix WHERE a >= 3 GROUP ALL).contains('Index') },
	{ q: 'u a < 3 ASC', ok: (SELECT VALUE id FROM u WITH INDEX ix WHERE a < 3 ORDER BY a ASC, b ASC, id) == (SELECT VALUE id FROM u WITH NOINDEX WHERE a < 3 ORDER BY a ASC, b ASC, id) },
	{ q: 'u a < 3 ASC (plan)', ok: (EXPLAIN SELECT VALUE id FROM u WITH INDEX ix WHERE a < 3 ORDER BY a ASC, b ASC, id).contains('Index') },
	{ q: 'u page a < 3 ASC', ok: (SELECT VALUE id FROM u WITH INDEX ix WHERE a < 3 ORDER BY a ASC, b ASC, id LIMIT 1 START 1) == (SELECT VALUE id FROM u WITH NOINDEX WHERE a < 3 ORDER BY a ASC, b ASC, id LIMIT 1 START 1) },
	{ q: 'u page a < 3 ASC (plan)', ok: (EXPLAIN SELECT VALUE id FROM u WITH INDEX ix WHERE a < 3 ORDER BY a ASC, b ASC, id LIMIT 1 START 1).contains('Index') },
	{ q: 'u a < 3 DESC', ok: (SELECT VALUE id FROM u WITH INDEX ix WHERE a < 3 ORDER BY a DESC, b DESC, id) == (SELECT VALUE id FROM u WITH NOINDEX WHERE a < 3 ORDER BY a DESC, b DESC, id) },
	{ q: 'u a < 3 DESC (plan)', ok: (EXPLAIN SELECT VALUE id FROM u WITH INDEX ix WHERE a < 3 ORDER BY a DESC, b DESC, id).contains('Index') },
	{ q: 'u page a < 3 DESC', ok: (SELECT VALUE id FROM u WITH INDEX ix WHERE a < 3 ORDER BY a DESC, b DESC, id LIMIT 1 START 1) == (SELECT VALUE id FROM u WITH NOINDEX WHERE a < 3 ORDER BY a DESC, b DESC, id LIMIT 1 START 1) },
	{ q: 'u page a < 3 DESC (plan)', ok: (EXPLAIN SELECT VALUE id FROM u WITH INDEX ix WHERE a < 3 ORDER BY a DESC, b DESC, id LIMIT 1 START 1).contains('Index') },
	{ q: 'u count a < 3', ok: (SELECT VALUE count() FROM u WITH INDEX ix WHERE a < 3 GROUP ALL) == (SELECT VALUE count() FROM u WITH NOINDEX WHERE a < 3 GROUP ALL) },
	{ q: 'u count a < 3 (plan)', ok: (EXPLAIN SELECT VALUE count() FROM u WITH INDEX ix WHERE a < 3 GROUP ALL).contains('Index') },
	{ q: 'u a <= 3 ASC', ok: (SELECT VALUE id FROM u WITH INDEX ix WHERE a <= 3 ORDER BY a ASC, b ASC, id) == (SELECT VALUE id FROM u WITH NOINDEX WHERE a <= 3 ORDER BY a ASC, b ASC, id) },
	{ q: 'u a <= 3 ASC (plan)', ok: (EXPLAIN SELECT VALUE id FROM u WITH INDEX ix WHERE a <= 3 ORDER BY a ASC, b ASC, id).contains('Index') },
	{ q: 'u page a <= 3 ASC', ok: (SELECT VALUE id FROM u WITH INDEX ix WHERE a <= 3 ORDER BY a ASC, b ASC, id LIMIT 1 START 1) == (SELECT VALUE id FROM u WITH NOINDEX WHERE a <= 3 ORDER BY a ASC, b ASC, id LIMIT 1 START 1) },
	{ q: 'u page a <= 3 ASC (plan)', ok: (EXPLAIN SELECT VALUE id FROM u WITH INDEX ix WHERE a <= 3 ORDER BY a ASC, b ASC, id LIMIT 1 START 1).contains('Index') },
	{ q: 'u a <= 3 DESC', ok: (SELECT VALUE id FROM u WITH INDEX ix WHERE a <= 3 ORDER BY a DESC, b DESC, id) == (SELECT VALUE id FROM u WITH NOINDEX WHERE a <= 3 ORDER BY a DESC, b DESC, id) },
