/**
[env]
namespace = true
database = true

[test]
reason = "A write refuses an argument to CURRENT_DATE, which takes none, as a read does"

[test.results]
request-error = "MySQL UPDATE lowering error: function \"current_date\" requires at most 0 arguments, but 1 were provided"
*/

UPDATE days SET at = CURRENT_DATE(1) WHERE id = 1;
