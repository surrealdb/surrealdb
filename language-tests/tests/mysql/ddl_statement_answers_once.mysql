*/

CREATE TABLE ddl_once_person (id INT PRIMARY KEY, name VARCHAR(50), email VARCHAR(50) UNIQUE, age INT);

CREATE TABLE IF NOT EXISTS ddl_once_person (id INT PRIMARY KEY, name VARCHAR(50), email VARCHAR(50) UNIQUE, age INT);

CREATE TABLE ddl_once_a (x INT);

CREATE TABLE ddl_once_b (y INT);

INSERT INTO ddl_once_person (id, name, email, age) VALUES (1, 'Tobie', 'tobie@example.com', 40);

INSERT INTO ddl_once_person (id, name, email, age) VALUES (2, 'Other', 'tobie@example.com', 41);

DROP TABLE ddl_once_a, ddl_once_b;

DROP TABLE IF EXISTS ddl_once_a, ddl_once_b;

SELECT x FROM ddl_once_a;
