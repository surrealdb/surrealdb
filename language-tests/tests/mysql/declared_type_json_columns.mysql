/**
[env]
namespace = true
database = true
imports = ["mysql/_declared_json.surql"]

[test]
reason = "Text written to a JSON column is JSON text: it is parsed into the value it spells, so the column holds an array and a scalar as well as an object, the last of duplicate keys is kept, and text that is not JSON is refused"

[[test.results]]
value = "[{ id: 1, j: [1, 2] }]"

[[test.results]]
value = "[{ id: 2, j: 5 }]"

[[test.results]]
value = "[{ id: 3, j: { a: 2 } }]"

[[test.results]]
value = "[{ id: 4, j: [true, NULL] }]"

[[test.results]]
error = "Incorrect arguments for function encoding::json::decode(). Invalid JSON"

[[test.results]]
value = "[{ id: 2, j: 'text' }]"

[[test.results]]
value = "[{ id: 1, j: [1, 2] }, { id: 2, j: 'text' }, { id: 3, j: { a: 2 } }, { id: 4, j: [true, NULL] }]"
*/

INSERT INTO jt (id, j) VALUES (1, CAST('[1, 2]' AS JSON));
INSERT INTO jt (id, j) VALUES (2, CAST('5' AS JSON));
INSERT INTO jt (id, j) VALUES (3, CAST('{"a": 1, "a": 2}' AS JSON));
INSERT INTO jt (id, j) VALUES (4, '[true, null]');
INSERT INTO jt (id, j) VALUES (5, '{not json');
UPDATE jt SET j = '"text"' WHERE id = 2;
SELECT id, j FROM jt ORDER BY id;
