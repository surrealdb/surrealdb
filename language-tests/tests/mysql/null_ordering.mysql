/**
[env]
namespace = true
database = true

[test]
reason = "MySQL NULL ordering semantics in ASC and DESC"

[[test.results]]
value = "NONE"

[[test.results]]
value = "NONE"

[[test.results]]
value = "NONE"

[[test.results]]
value = "[{ id: scores:1, score: 100 }, { id: scores:2, score: NULL }, { id: scores:3, score: 50 }]"

[[test.results]]
value = "[{ id: scores:2 }, { id: scores:3 }, { id: scores:1 }]"

[[test.results]]
value = "[{ id: scores:1 }, { id: scores:3 }, { id: scores:2 }]"
*/

CREATE TABLE scores (id INT, score INT);
INSERT INTO scores (id, score) VALUES (1, 100), (2, NULL), (3, 50);
SELECT s.id FROM scores s ORDER BY s.score ASC;
SELECT s.id FROM scores s ORDER BY s.score DESC;
