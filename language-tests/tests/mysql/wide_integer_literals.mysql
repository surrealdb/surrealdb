/**
[env]
namespace = true
database = true
imports = ["mysql/_wide_integers.surql"]

[test]
reason = "A decimal integer literal beyond 64 bits is a float and compares with integer values, the minimum BIGINT is an integer literal, and DIV is exact for integral operands and divides before it truncates otherwise"

[[test.results]]
value = "[]"

[[test.results]]
value = "[{ id: 1 }, { id: 2 }, { id: 3 }, { id: 4 }, { id: 5 }]"

[[test.results]]
value = "[{ id: 1 }, { id: 2 }, { id: 3 }, { id: 5 }]"

[[test.results]]
value = "[{ id: 1 }, { id: 2 }, { id: 3 }, { id: 4 }, { id: 5 }]"

[[test.results]]
value = "[{ id: 4 }]"

[[test.results]]
value = "[{ lowest: -9223372036854775808 }]"

[[test.results]]
value = "[{ wide: 10000000000000000000u64 }]"

[[test.results]]
value = "[{ remainder: 0 }]"

[[test.results]]
value = "[{ quotient: 2 }]"

[[test.results]]
value = "[{ quotient: 9223372036854775807 }]"

[[test.results]]
value = "[{ quotient: 4611686018427387903 }]"

[[test.results]]
value = "[{ quotient: 1537228672809129301 }]"
*/

SELECT id FROM ledger WHERE amount > 10000000000000000000 ORDER BY id;

SELECT id FROM ledger WHERE amount < 10000000000000000000 ORDER BY id;

SELECT id FROM ledger WHERE amount > -9223372036854775808 ORDER BY id;

SELECT id FROM ledger WHERE amount >= -9223372036854775808 ORDER BY id;

SELECT id FROM ledger WHERE amount = -9223372036854775808;

SELECT -9223372036854775808 AS lowest;

SELECT 10000000000000000000 AS wide;

SELECT -9223372036854775808 % -1 AS remainder;

SELECT 1 DIV 0.5 AS quotient;

SELECT 9223372036854775807 DIV 1.0 AS quotient;

SELECT 9223372036854775807 DIV 2.0 AS quotient;

SELECT 4611686018427387904.0 DIV 3 AS quotient;
