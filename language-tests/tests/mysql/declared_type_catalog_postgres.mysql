/**
[env]
namespace = true
database = true
imports = ["mysql/_pg_declared_columns.surql"]

[test]
reason = "information_schema.COLUMNS reports a column declared with a PostgreSQL type by the nearest MySQL type"

[[test.results]]
value = "[{ character_maximum_length: 4294967295, column_name: 'body', column_type: 'longtext', data_type: 'longtext', datetime_precision: NULL, numeric_precision: NULL, numeric_scale: NULL }, { character_maximum_length: NULL, column_name: 'id', column_type: 'text', data_type: 'text', datetime_precision: NULL, numeric_precision: NULL, numeric_scale: NULL }, { character_maximum_length: NULL, column_name: 'n', column_type: 'decimal(10,2)', data_type: 'decimal', datetime_precision: NULL, numeric_precision: 10, numeric_scale: 2 }, { character_maximum_length: NULL, column_name: 'ts', column_type: 'datetime(3)', data_type: 'datetime', datetime_precision: 3, numeric_precision: NULL, numeric_scale: NULL }, { character_maximum_length: 36, column_name: 'u', column_type: 'char(36)', data_type: 'char', datetime_precision: NULL, numeric_precision: NULL, numeric_scale: NULL }, { character_maximum_length: 20, column_name: 'v', column_type: 'varchar(20)', data_type: 'varchar', datetime_precision: NULL, numeric_precision: NULL, numeric_scale: NULL }]"
*/

SELECT COLUMN_NAME, COLUMN_TYPE, DATA_TYPE, CHARACTER_MAXIMUM_LENGTH, NUMERIC_PRECISION, NUMERIC_SCALE, DATETIME_PRECISION FROM information_schema.COLUMNS WHERE TABLE_NAME = 'pg_declared' ORDER BY COLUMN_NAME;
