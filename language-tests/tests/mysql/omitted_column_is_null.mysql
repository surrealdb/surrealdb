/**
[env]
namespace = true
database = true
imports = ["mysql/_omitted_column.surql"]

[test]
reason = "A column an INSERT or a REPLACE leaves out holds NULL, as one it gives NULL does, so that the rows are one value to GROUP BY and UNION; a column with a DEFAULT takes the default"

[[test.results]]
value = "[{ a: 10, b: NULL, d: 7, id: 1 }]"

[[test.results]]
value = "[{ a: 20, b: NULL, d: 7, id: 2 }]"

[[test.results]]
value = "[{ a: 30, b: 'x', d: 7, id: 3 }]"

[[test.results]]
value = "[{ a: 40, b: NULL, d: 7, id: 4 }]"

[[test.results]]
value = "[{ a: 10, b: NULL, d: 7, id: 1 }, { a: 20, b: NULL, d: 7, id: 2 }, { a: 30, b: 'x', d: 7, id: 3 }, { a: 40, b: NULL, d: 7, id: 4 }]"

[[test.results]]
value = "[{ b: NULL }, { b: 'x' }]"

[[test.results]]
value = "[{ b: NULL }, { b: 'x' }]"

[[test.results]]
value = "[{ n: 3 }]"
*/

INSERT INTO omit_t (id, a) VALUES (1, 10);

INSERT INTO omit_t (id, a, b) VALUES (2, 20, NULL);

INSERT INTO omit_t (id, a, b) VALUES (3, 30, 'x');

REPLACE INTO omit_t (id, a) VALUES (4, 40);

SELECT id, a, b, d FROM omit_t ORDER BY id;

SELECT b FROM omit_t GROUP BY b ORDER BY b;

SELECT b FROM omit_t UNION SELECT b FROM omit_t ORDER BY b;

SELECT count(*) AS n FROM omit_t WHERE b IS NULL;
