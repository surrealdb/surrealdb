/**
[env]
namespace = true
database = true
imports = ["mysql/_sql_types.surql"]

[test]
reason = "MySQL YEAR, BIT(n) and spatial columns: a write is checked against the declared type and stored as its kind, a two-digit year reads as its century, and a read gives the stored value"

[[test.results]]
value = "[{ built: 1999u16, flags: 15u64, id: 2 }]"

[[test.results]]
value = "[{ built: 2024u16, flags: 5u64, id: 1, spot: (1.5f, 2.5f) }, { built: 1999u16, flags: 15u64, id: 2, spot: NONE }]"

[[test.results]]
error = 'the value of column "built" is out of range for year (field `built` of `place:3`, SQL TYPE year)'

[[test.results]]
error = "Data too long for column 'flags' at row 1 (field `flags` of `place:4`, SQL TYPE bit(4))"
*/

INSERT INTO place (id, built, flags) VALUES (2, 99, 15);

SELECT id, built, flags, spot FROM place ORDER BY id;

INSERT INTO place (id, built) VALUES (3, 1800);

INSERT INTO place (id, flags) VALUES (4, 16);
