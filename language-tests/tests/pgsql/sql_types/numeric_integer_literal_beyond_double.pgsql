/**
[env]
namespace = true
database = true

[test]
reason = "a decimal integer literal beyond the range of a double is a numeric constant, as PostgreSQL's numeric holds up to 131072 integer digits"

[[test.results]]
value = "[{ n:  }]"

[[test.results]]
value = "[{ digits: 400, ty: 'numeric' }]"

[[test.results]]
value = "[{ larger: true }]"
*/

SELECT  AS n;

SELECT length(()::text) AS digits, pg_typeof() AS ty;

SELECT  + 1 >  AS larger;
